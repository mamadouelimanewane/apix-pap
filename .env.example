# =================================================================
# APIX-PAP — Variables d'Environnement
# =================================================================
# Copiez ce fichier en ".env.local" pour le développement local
# En production, configurez ces variables dans Vercel

# -----------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------
# Neon PostgreSQL (https://console.neon.tech/)
# À configurer dans Vercel Environment Variables avec votre vraie connection string
DATABASE_URL="YOUR_NEON_CONNECTION_STRING_HERE"

# -----------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------
# Secret pour signer les JWT (générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# À configurer dans Vercel Environment Variables
JWT_SECRET="YOUR_JWT_SECRET_HERE"

# Durée de validité du JWT (ex: "24h")
JWT_EXPIRY="24h"

# -----------------------------------------------------------------
# Email (Resend pour OTP ou notifications)
# -----------------------------------------------------------------
# API Key depuis https://resend.com
RESEND_API_KEY="re_xxx"

# Email d'expéditeur
RESEND_FROM_EMAIL="no-reply@apix-pap.sn"

# -----------------------------------------------------------------
# Stockage de fichiers (Vercel Blob pour prod)
# -----------------------------------------------------------------
# Optionnel en développement (utilise dossier /public)
BLOB_READ_WRITE_TOKEN="your_token_here"

# -----------------------------------------------------------------
# Données d'Import
# -----------------------------------------------------------------
# Chemin vers fichier Excel PAP existant (pour import initial)
IMPORT_EXCEL_PATH="./data/pap_existants.xlsx"

# Code projet par défaut pour import
DEFAULT_PROJET_CODE="GT-001"

# -----------------------------------------------------------------
# Configuration Application
# -----------------------------------------------------------------
# Montant minimum par m² pour terrain (FCFA)
MIN_PRIX_TERRAIN_PAR_M2="1000"

# Montant maximum par m² pour terrain (anomalie si dépasse)
MAX_PRIX_TERRAIN_PAR_M2="100000"

# Délai SLA pour répondre aux réclamations (jours)
SLA_RECLAMATIONS="30"

# -----------------------------------------------------------------
# Développement
# -----------------------------------------------------------------
# Mode debug
DEBUG="false"

# Port serveur dev
VITE_PORT="5173"
