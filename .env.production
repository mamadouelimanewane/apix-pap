# ===========================
# VERCEL PRODUCTION DEPLOYMENT
# ===========================

# API Backend URL (Set in Vercel Dashboard)
# Step 1: Deploy backend to Railway/Render
# Step 2: Copy backend URL here or set in Vercel Environment Variables
# Example values:
# VITE_APP_API_URL=https://apix-pap-backend.up.railway.app/api  (Railway)
# VITE_APP_API_URL=https://apix-pap-api.onrender.com/api         (Render)

VITE_APP_API_URL=@vite_app_api_url

# Application Title
VITE_APP_TITLE=APIX-PAP - Affectés par la Terre

# Debug Mode (disabled in production)
VITE_DEBUG=@vite_debug

# Storage Configuration
VITE_STORAGE_PREFIX=apix_pap_

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=600000

# Session Configuration
VITE_SESSION_TIMEOUT=60
VITE_API_RETRY_COUNT=3
VITE_API_RETRY_DELAY=2000

# Build Optimization
NODE_ENV=production

# ===========================
# VERCEL ENVIRONMENT SETUP
# ===========================
#
# 1. Go to: https://vercel.com/dashboard
# 2. Import project from GitHub
# 3. Add Environment Variables:
#
#    VITE_APP_API_URL=https://your-backend-url.com/api
#    VITE_DEBUG=false
#
# 4. Deploy!
#
# Backend URL Examples:
# - Railway: https://apix-pap-backend.up.railway.app/api
# - Render:  https://apix-pap-api.onrender.com/api
# - Fly.io:  https://apix-pap-backend.fly.dev/api
#

# ============================================================================
# PHASE 4: STOCKAGE & INTÉGRATION
# ============================================================================

# Storage Provider: vercel-blob, s3, firebase
STORAGE_PROVIDER=vercel-blob
STORAGE_BUCKET=apix-pap-documents

# AWS S3 (If using S3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=apix-pap-documents

# Firebase (If using Firebase)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Cadastre API Integration
CADASTRE_API_URL=https://api.cadastre.sn
CADASTRE_API_KEY=your_cadastre_api_key

# ============================================================================
# PHASE 5: OCR & VISION
# ============================================================================

# Tesseract.js Configuration
TESSERACT_WORKERS=3
TESSERACT_LANGUAGES=fre,eng
TESSERACT_CACHE_SIZE=104857600

# Google Vision API
GOOGLE_VISION_KEY=your_google_vision_api_key
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_VISION_ENABLED=true

# ============================================================================
# NOTIFICATIONS - Webhooks
# ============================================================================

# Twilio SMS
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+221123456789

# Resend Email
RESEND_ENABLED=true
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@apix-pap.com

# Slack Webhooks
SLACK_ENABLED=true
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#apix-notifications

# SendGrid (Alternative Email)
SENDGRID_ENABLED=false
SENDGRID_API_KEY=your_sendgrid_key

# ============================================================================
# BLOCKCHAIN AUDIT - Phase 5
# ============================================================================

# Blockchain Provider: ethereum, polygon, hyperledger
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_PROVIDER=polygon
BLOCKCHAIN_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_CHAIN_ID=137

# Smart Contract
AUDIT_CONTRACT_ADDRESS=0x...
AUDIT_CONTRACT_ABI=./abi/AuditContract.json

# Wallet Configuration
PRIVATE_KEY=your_wallet_private_key
GAS_PRICE=standard

# ============================================================================
# MOBILE APP - Expo
# ============================================================================

EXPO_ENABLED=true
EXPO_PROJECT_ID=your_expo_project_id
EXPO_SLUG=apix-pap-mobile

# Push Notifications (Expo)
EXPO_PUSH_ENABLED=true

# API Endpoint
EXPO_API_BASE_URL=https://apix-papa.vercel.app/api

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Sentry Error Tracking
SENTRY_ENABLED=true
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project-id

# Google Analytics
GA_ENABLED=true
GA_TRACKING_ID=G-XXXXXXXXXX

# Datadog (Optional)
DATADOG_ENABLED=false
DATADOG_API_KEY=your_datadog_key

# ============================================================================
# SECURITY
# ============================================================================

# CORS
CORS_ORIGIN=https://apix-papa.vercel.app
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Headers
ENABLE_HELMET=true
ENABLE_CSP=true

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=file

# Slack Logging
SLACK_LOGS_ENABLED=true
SLACK_LOGS_CHANNEL=#apix-logs

# ============================================================================
# FEATURES FLAGS
# ============================================================================

FEATURE_BLOCKCHAIN=true
FEATURE_WEBHOOKS=true
FEATURE_MOBILE=true
FEATURE_TESSERACT=true
FEATURE_GOOGLE_VISION=true
FEATURE_RISK_SCORING=true
FEATURE_PAP_AUTO_CREATE=true

# ============================================================================
# PERFORMANCE
# ============================================================================

CACHE_ENABLED=true
CACHE_TTL=3600
REDIS_URL=redis://your_redis_url

# Image Optimization
IMAGE_COMPRESSION_QUALITY=0.8
MAX_IMAGE_SIZE=5242880

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================

AUDIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90
AUDIT_LOG_TABLE=public.audit_trail

# GDPR
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555

# ============================================================================
# ENVIRONMENT
# ============================================================================

NODE_ENV=production
VERCEL_ENV=production

# Build
BUILD_VERSION=1.0.0
BUILD_TIME=2026-08-26T00:00:00Z
