# ===========================
# Frontend Configuration - Development
# ===========================

# API Backend URL
VITE_APP_API_URL=http://localhost:3000/api

# Backend Health Check
VITE_APP_API_HEALTH=http://localhost:3000/health

# Application Title
VITE_APP_TITLE=APIX-PAP - Affectés par la Terre

# Debug Mode
VITE_DEBUG=true

# Local Storage Prefix
VITE_STORAGE_PREFIX=apix_pap_

# Session Timeout (minutes)
VITE_SESSION_TIMEOUT=30

# API Retry Configuration
VITE_API_RETRY_COUNT=3
VITE_API_RETRY_DELAY=1000

# Cache Configuration
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# Note: Backend doit être lancé avant le frontend
# npm run dev (backend)  -> http://localhost:3000
# npm run dev (frontend) -> http://localhost:5173
